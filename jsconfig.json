{
  "compilerOptions": {
    "baseUrl": "./",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "target": "ES6",
    "allowSyntheticDefaultImports": true,
    "types": [
      "vite/client",
      "element-plus/global"
    ],
    "checkJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.jsx",
    "src/**/*.vue"
  ],
  "exclude": ["node_modules", "dist"]
}
